          <p className={styles.featureDesc}>We use high-quality products that won&apos;t damage your hair, eyelashes, etc</p>
        </div>
        <div className={styles.featureCard}>
          <div className={styles.featureHeader}>
            <Sparkles size={20} color="var(--gold)" />
            <h3 className={styles.featureTitle}>Professional Make up</h3>
            <Sparkles size={20} color="var(--gold)" />
          </div>
          <p className={styles.featureDesc}>Our professional team, led by Melissa, will ensure you receive the best makeup design. You&apos;ll look so beautiful that nobody will recognize you</p>
        </div>
        <div className={styles.featureCard}>
          <div className={styles.featureHeader}>
            <Sparkles size={20} color="var(--gold)" />
