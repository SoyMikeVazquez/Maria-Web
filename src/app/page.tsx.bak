    link: "https://mariabonitabeautysalon.com/decolorar-cabello-rojo-lo-que-necesitas-saber/"
  }
];

export default function Home() {
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const [scrolled, setScrolled] = useState(false);
  const [mounted, setMounted] = useState(false);
  
  // Slider states
  const [aboutIndex, setAboutIndex] = useState(0);
  const [assistIndex, setAssistIndex] = useState(0);
  const [spaIndex, setSpaIndex] = useState(0);

  const aboutImages = [
    "https://cdn.prod.website-files.com/6397a990f9c238169485ce1d/6978e3758633e24c739d19eb_Gemini_Generated_Image_clm6hgclm6hgclm6.jpg",
    "https://cdn.prod.website-files.com/6397a990f9c238169485ce1d/6978e377d9dbb24edb7cd475_pexels-olia-danilevich-4723182-2.jpg"
  ];

  const assistImages = [
    "https://cdn.prod.website-files.com/6397a990f9c238169485ce1d/65f30b6f07a3878e25a5aba1_Mari%CC%81a%20(1).jpg",
    "https://cdn.prod.website-files.com/6397a990f9c238169485ce1d/65f30b5e93824c0dc4175a6f_Mari%CC%81a%20(2).jpg"
  ];

  const melissaImages = [
    "/melissa/Unknown-2.jpg",
    "/melissa/Unknown-5.jpg",
    "/melissa/dss.jpg",
    "/melissa/ss.jpg"
  ];

  const spaImages = [
    "/spa/spa.jpeg",
    "/spa/spa2.jpeg",
    "/spa/spa3.jpeg",
    "/spa/spa4.jpeg"
  ];

  useEffect(() => {
    setMounted(true);
    
    const handleScroll = () => {
      if (window.scrollY > 100) {
        setScrolled(true);
      } else {
        setScrolled(false);
      }
    };
    
    // Auto-rotate sliders
    const aboutInterval = setInterval(() => {
      setAboutIndex((prev) => (prev + 1) % aboutImages.length);
    }, 5000);

    const assistInterval = setInterval(() => {
      setAssistIndex((prev) => (prev + 1) % assistImages.length);
    }, 5000);

    const spaInterval = setInterval(() => {
      setSpaIndex((prev) => (prev + 1) % spaImages.length);
    }, 5000);

    // Scroll Reveal Observer
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('active');
          }
        });
      },
      { threshold: 0.05 }
    );

    const revealElements = document.querySelectorAll('.reveal');
    revealElements.forEach((el) => observer.observe(el));

    window.addEventListener('scroll', handleScroll);
    return () => {
      window.removeEventListener('scroll', handleScroll);
      clearInterval(aboutInterval);
      clearInterval(assistInterval);
      clearInterval(spaInterval);
      revealElements.forEach((el) => observer.unobserve(el));
    };
  }, []);

  const toggleMenu = () => {
    setIsMenuOpen(!isMenuOpen);
  };

  const nextAbout = () => setAboutIndex((prev) => (prev + 1) % aboutImages.length);
  const prevAbout = () => setAboutIndex((prev) => (prev - 1 + aboutImages.length) % aboutImages.length);
  
  const nextAssist = () => setAssistIndex((prev) => (prev + 1) % assistImages.length);
  const prevAssist = () => setAssistIndex((prev) => (prev - 1 + assistImages.length) % assistImages.length);

  const nextSpa = () => setSpaIndex((prev) => (prev + 1) % spaImages.length);
  const prevSpa = () => setSpaIndex((prev) => (prev - 1 + spaImages.length) % spaImages.length);

  return (
    <>
      <div className="preloader">
        <div className="spinner"></div>
      </div>
      
      {/* Sticky Navigation */}
      <div className={`${styles.stickyNav} ${scrolled ? styles.scrolled : ''}`}>
        <div className={styles.navLeft}>
          <div className={styles.dot}></div>
          <span className={styles.salonText}>Beauty Salon</span>
          <div className={styles.navSeparator}></div>
          <div className={styles.navSocials}>
            <a href="https://www.instagram.com/maria_bonitabeautysalon/" target="_blank" rel="noopener noreferrer" className={styles.navSocialLink}>
              <InstagramIcon size={14} />
            </a>
            <a href="https://www.facebook.com/barrientostony/" target="_blank" rel="noopener noreferrer" className={styles.navSocialLink}>
              <FacebookIcon size={14} />
            </a>
            <a href="https://www.tiktok.com/@mariabonitabeautysalon_" target="_blank" rel="noopener noreferrer" className={styles.navSocialLink}>
              <TikTokIcon size={14} />
            </a>
          </div>
        </div>
        <div className={styles.brand}>
          <Image src="/maria.png" alt="María Bonita" width={150} height={50} className={styles.brandLogo} />
        </div>
        <div className={styles.navRight} onClick={toggleMenu}>
          <span className={styles.menuText}>MENU</span>
          <div className={`${styles.hamburger} ${isMenuOpen ? styles.active : ''}`}>
            <div className={styles.line}></div>
            <div className={styles.line}></div>
            <div className={styles.line}></div>
          </div>
        </div>
      </div>
      
      {/* Hero Section */}
      <main id="home" className={styles.hero}>
        <div className={styles.backgroundImage}></div>
        
        <nav className={styles.nav}>
          <div className={styles.navLeft}>
            <div className={styles.dot}></div>
            <span className={styles.salonText}>Beauty Salon</span>
            <div className={styles.navSeparator}></div>
            <div className={styles.navSocials}>
              <a href="https://www.instagram.com/maria_bonitabeautysalon/" target="_blank" rel="noopener noreferrer" className={styles.navSocialLink}>
                <InstagramIcon size={14} />
              </a>
              <a href="https://www.facebook.com/barrientostony/" target="_blank" rel="noopener noreferrer" className={styles.navSocialLink}>
                <FacebookIcon size={14} />
              </a>
              <a href="https://www.tiktok.com/@mariabonitabeautysalon_" target="_blank" rel="noopener noreferrer" className={styles.navSocialLink}>
                <TikTokIcon size={14} />
              </a>
            </div>
          </div>
          
          <div className={styles.brand}>
            <Image src="/maria.png" alt="María Bonita" width={150} height={50} className={styles.brandLogo} />
          </div>
          
          <div className={styles.navRight} onClick={toggleMenu}>
            <span className={styles.menuText}>MENU</span>
            <div className={`${styles.hamburger} ${isMenuOpen ? styles.active : ''}`}>
              <div className={styles.line}></div>
              <div className={styles.line}></div>
              <div className={styles.line}></div>
            </div>
          </div>
        </nav>

        <div className={styles.heroContent}>
          <div className={styles.marqueeContainerTop}>
            <div className={styles.marqueeContentReverse}>
              <span className={styles.mainHeading}>SHINE WITH YOUR OWN LIGHT</span>
              <span className={styles.mainHeading}>SHINE WITH YOUR OWN LIGHT</span>
              <span className={styles.mainHeading}>SHINE WITH YOUR OWN LIGHT</span>
            </div>
          </div>

          <div className={styles.marqueeContainer}>
            <div className={styles.marqueeContent}>
              <span className={styles.marqueeText}>WE PROVIDE YOU WITH THE BEST SALON SERVICES </span>
              <span className={styles.marqueeText}>WE PROVIDE YOU WITH THE BEST SALON SERVICES </span>
            </div>
          </div>
          
          <a href="https://appmariabonitasalon.flutterflow.app/citawebpro" target="_blank" rel="noopener noreferrer" className={styles.ctaButton}>SCHEDULE AN APPOINTMENT</a>
        </div>

        <div className={`${styles.menuOverlay} ${isMenuOpen ? styles.active : ''}`}>
          <div className={styles.closeButton} onClick={toggleMenu}>
            <div className={styles.closeLine}></div>
            <div className={styles.closeLine}></div>
          </div>
          <div className={styles.menuLinks}>
            <a href="#home" className={styles.menuLink} style={{ transitionDelay: '0.1s' }} onClick={() => setIsMenuOpen(false)}>HOME</a>
            <a href="#services" className={styles.menuLink} style={{ transitionDelay: '0.2s' }} onClick={() => setIsMenuOpen(false)}>SERVICES</a>
            <a href="#spa" className={styles.menuLink} style={{ transitionDelay: '0.3s' }} onClick={() => setIsMenuOpen(false)}>SPA</a>
            <a href="#about" className={styles.menuLink} style={{ transitionDelay: '0.4s' }} onClick={() => setIsMenuOpen(false)}>ABOUT</a>
            <a href="#gallery" className={styles.menuLink} style={{ transitionDelay: '0.5s' }} onClick={() => setIsMenuOpen(false)}>GALLERY</a>
            <a href="#blog" className={styles.menuLink} style={{ transitionDelay: '0.6s' }} onClick={() => setIsMenuOpen(false)}>BLOG</a>
            <a href="#location" className={styles.menuLink} style={{ transitionDelay: '0.7s' }} onClick={() => setIsMenuOpen(false)}>LOCATION</a>
            <div className={styles.mobileSocials} style={{ transitionDelay: '0.8s' }}>
              <a href="https://www.instagram.com/maria_bonitabeautysalon/" target="_blank" rel="noopener noreferrer"><InstagramIcon size={24} /></a>
              <a href="https://www.facebook.com/barrientostony/" target="_blank" rel="noopener noreferrer"><FacebookIcon size={24} /></a>
              <a href="https://www.tiktok.com/@mariabonitabeautysalon_" target="_blank" rel="noopener noreferrer"><TikTokIcon size={24} /></a>
            </div>
          </div>
        </div>
      </main>

      {/* New Spa Section */}
      <section id="spa" className={`${styles.aboutSection} reveal`}>
        <div className={styles.aboutSubtitle}>/ N E W &nbsp; S P A &nbsp; O P E N I N G</div>
        <div className={styles.aboutContent}>
          <div className={styles.aboutText}>
            <h2 className={styles.aboutHeading}>DISCOVER OUR NEW SPA SERVICES</h2>
            <p className={styles.aboutDesc}>
              We are thrilled to announce the opening of our brand new Spa section. 
              Designed as an oasis of tranquility, it features the following characteristics:
            </p>
            <ul style={{ listStyleType: 'disc', paddingLeft: '20px', marginTop: '10px', color: '#666', fontFamily: 'var(--font-poppins)', fontSize: '14px', lineHeight: '1.6' }}>
              <li>Relaxing Massages (Deep tissue, Swedish)</li>
              <li>Rejuvenating Facial Treatments</li>
              <li>Aromatherapy & Holistic Care</li>
              <li>Aesthetic Treatments & Skincare</li>
            </ul>
          </div>
          <div className={styles.aboutImageWrapper}>
            <div className={`${styles.sliderArrow} ${styles.sliderArrowLeft}`} onClick={prevSpa}>‹</div>
            <Image 
              src={spaImages[spaIndex]} 
              alt="Spa Experience" 
              fill 
              className={styles.aboutImage}
            />
            <div className={`${styles.sliderArrow} ${styles.sliderArrowRight}`} onClick={nextSpa}>›</div>
          </div>
        </div>
      </section>

      {/* About Section */}
      <section id="about" className={`${styles.aboutSection} reveal`}>
        <div className={styles.aboutSubtitle}>/ A B O U T &nbsp; U S</div>
        <div className={styles.aboutContent}>
          <div className={styles.aboutText}>
            <h2 className={styles.aboutHeading}>Q U A L I T Y<br/>C E R T I F I C A T I O N &nbsp; I N<br/>M I N N E S O T A</h2>
            <div className={styles.aboutDescription}>
              <p className={styles.aboutIntro}>We are a premier salon in Minnesota for three key reasons:</p>
              
              <p className={styles.aboutDescriptionItem}>
                <strong className={styles.aboutDescriptionTitle}>Hair Health First: </strong>
                Our top priority is the integrity and health of your hair.
              </p>
              
              <p className={styles.aboutDescriptionItem}>
                <strong className={styles.aboutDescriptionTitle}>Premium Products: </strong>
                We exclusively use certified, high-quality products. We never compromise with low-quality alternatives that could damage your hair over time.
              </p>
              
              <p className={styles.aboutDescriptionItem}>
                <strong className={styles.aboutDescriptionTitle}>Expert Staff: </strong>
                Our team is professionally trained, fully certified, and dedicated to excellence.
              </p>
            </div>
          </div>
          <div className={styles.aboutImageWrapper}>
            <div className={`${styles.sliderArrow} ${styles.sliderArrowLeft}`} onClick={prevAbout}>‹</div>
            <Image 
              src={aboutImages[aboutIndex]} 
              alt="Quality Salon Service" 
              fill 
              className={styles.aboutImage}
            />
            <div className={`${styles.sliderArrow} ${styles.sliderArrowRight}`} onClick={nextAbout}>›</div>
          </div>
        </div>
      </section>

      {/* Step Inside Section */}
      <section className={`${styles.stepInsideSection} reveal`}>
        <h2 className={styles.stepInsideHeading}>STEP INSIDE — BEAUTY BEGINS HERE</h2>
        <div className={styles.videosContainer}>
          <div className={styles.videoWrapper}>
            <video className={styles.stepVideo} autoPlay loop muted playsInline>
              <source src="https://cdn.prod.website-files.com/6397a990f9c238169485ce1d%2F68960ba4c20e34719ba73ab6_3-transcode.mp4" type="video/mp4" />
            </video>
          </div>
          <div className={styles.videoWrapper}>
            <video className={styles.stepVideo} autoPlay loop muted playsInline>
              <source src="https://cdn.prod.website-files.com/6397a990f9c238169485ce1d%2F68960ce9329227adb01a3b48_4-transcode.mp4" type="video/mp4" />
            </video>
          </div>
        </div>
      </section>

      {/* Services Intro Section */}
      <section id="services" className={`${styles.servicesIntroSection} reveal`}>
        <div className={styles.servicesSubtitle}>/ S E R V I C E S &nbsp; / S E R V I C I O S</div>
        <h2 className={styles.servicesHeading}>EVERY TRANSFORMATION STARTS WITH THE DECISION TO EMBRACE CHANGE.</h2>
        <p className={styles.servicesIntroText}>
          Located in Richfield, Minnesota, María Bonita Beauty Salon is a welcoming space dedicated to holistic beauty and self-care. We offer high quality services in a calm, comfortable environment where every client feels valued and cared for. Our goal is simple: to help you look and feel your best while enjoying a relaxing, personalized experience.
        </p>
      </section>

      {/* Parallax Image Section */}
      <div className={styles.parallaxSection}></div>

      {/* Services Grid Section */}
      <section className={`${styles.servicesGridSection} reveal`}>
        <div className={styles.servicesGrid}>
          {services.map((service, idx) => (
            <div key={idx} className={styles.serviceCard}>
              <div className={styles.serviceImageWrapper}>
                <Image 
                  src={service.img} 
                  alt={service.title} 
                  fill 
                  className={styles.serviceImage}
                />
              </div>
              <div className={styles.serviceInfo}>
                <h3 className={styles.serviceTitle}>{service.title}</h3>
                <p className={styles.serviceDesc}>{service.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      {/* Gallery Section */}
      <section id="gallery" className={`${styles.gallerySection} reveal`}>
        <h2 className={styles.galleryHeading}>MARÍA BONITA BEAUTY SALON PHOTOS</h2>
        <div className={styles.galleryGrid}>
          {services.slice(0, 4).map((service, idx) => (
            <div key={idx} className={styles.galleryImageWrapper}>
              <Image src={service.img} alt="Gallery Photo" fill className={styles.aboutImage} />
            </div>
          ))}
          {/* Second Row from Melissa folder */}
          {melissaImages.map((img, idx) => (
            <div key={`melissa-${idx}`} className={styles.galleryImageWrapper}>
              <Image src={img} alt={`Melissa Photo ${idx + 1}`} fill className={styles.aboutImage} />
            </div>
          ))}
        </div>
      </section>



      {/* Assist Section */}
      <section className={`${styles.assistSection} reveal`}>
        <div className={styles.aboutImageWrapper}>
          <div className={`${styles.sliderArrow} ${styles.sliderArrowLeft}`} onClick={prevAssist}>‹</div>
          <Image 
            src={assistImages[assistIndex]} 
            alt="Assist Staff" 
            fill 
            className={styles.aboutImage}
          />
          <div className={`${styles.sliderArrow} ${styles.sliderArrowRight}`} onClick={nextAssist}>›</div>
        </div>
        <div className={styles.assistTextContainer}>
          <h2 className={styles.assistHeading}>WE WILL BE HAPPY TO<br/>ASSIST YOU</h2>
          <p className={styles.assistDesc}>
            We are here to serve you, and even if we are not available, we continuously train our staff to provide you with the best service.
          </p>
        </div>
      </section>

      {/* Blog Section */}
      <section id="blog" className={`${styles.blogSection} reveal`}>
        <h2 className={styles.blogSubtitle}>LET&apos;S TALK ABOUT YOUR TRANSFORMATION</h2>
        <h3 className={styles.blogHeading}>BLOG</h3>
        <div className={styles.blogGrid}>
          {blogPosts.map((post, idx) => (
            <div key={idx} className={styles.blogCard}>
              <div className={styles.blogImageWrapper}>
                <Image src={post.img} alt={post.title} fill className={styles.aboutImage} />
              </div>
              <a href={post.link} className={styles.blogTitle}>{post.title}</a>
              <p className={styles.blogSnippet}>{post.snippet}</p>
              <a href={post.link} className={styles.blogLink}>Ver post completo</a>
            </div>
          ))}
        </div>
      </section>

      {/* YouTube Videos Section */}
      <section className={styles.videoSection}>
        <div className={styles.videoGrid}>
          <iframe className={styles.videoIframe} src="https://www.youtube.com/embed/jz6QNmWcjWY?feature=oembed" title="YouTube video 1" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowFullScreen></iframe>
          <iframe className={styles.videoIframe} src="https://www.youtube.com/embed/icrYjbzlR6A?feature=oembed" title="YouTube video 2" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowFullScreen></iframe>
          <iframe className={styles.videoIframe} src="https://www.youtube.com/embed/qdsDXdB5vFg?feature=oembed" title="YouTube video 3" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowFullScreen></iframe>
          <iframe className={styles.videoIframe} src="https://www.youtube.com/embed/U3-rkrmLP_4?feature=oembed" title="YouTube video 4" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowFullScreen></iframe>
